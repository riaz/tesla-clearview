# --- Tesla developer app (developer.tesla.com) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_DOMAIN=yourname.github.io
TESLA_REGION=na              # na | eu | cn
TESLA_REDIRECT_URI=http://localhost:8765/callback
TESLA_VIN=                   # optional; first vehicle if empty
TESLA_COMMAND_PROXY_URL=https://localhost:4443
TESLA_PROXY_CA_CERT=config/tls-cert.pem

# --- Claude vision ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
TESLACAM_PATH=               # e.g. /Volumes/TESLADRIVE/TeslaCam or a synced folder
CLIP_MAX_AGE_MIN=30

# --- Weather before waking the car (lat/lon of where you usually park) ---
HOME_LAT=
HOME_LON=

# --- Climate ---
TARGET_TEMP_C=21
MIN_BATTERY_PCT=20
DEFAULT_LEAD_MIN=10
DEFROST_LEAD_MIN=20
STOP_GRACE_MIN=15
SEAT_HEAT_BELOW_C=5

# --- Notifications (ntfy app) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                  # long random string
NTFY_TOKEN=

# --- HTTP trigger API ---
CLEARVIEW_API_TOKEN=         # openssl rand -hex 24
API_HOST=127.0.0.1
API_PORT=8787
